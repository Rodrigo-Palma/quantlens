# Copy to .env and fill in. Never commit .env.
# Default: local LLM via Ollama (offline, no API key needed).
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:32b

# Any OpenAI-compatible endpoint (OpenAI, vLLM, LM Studio, Ollama /v1):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com
# LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
